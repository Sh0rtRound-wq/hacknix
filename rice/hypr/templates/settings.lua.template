-- Border colours are owned by matugen (colors.lua). Guarded: on a fresh install the file
-- may not exist yet, and a missing module would kill this file.
local ok, colours = pcall(require, "colors")
if not ok or type(colours) ~= "table" then
  colours = { active_border = "rgba(00FF41ee)", inactive_border = "rgba(00000000)" }
end

hl.config({
    general = {
        border_size = 4,
        gaps_in = 4,
        gaps_out = 8,
        resize_on_border = true,
        extend_border_grab_area = 30,
        col = {
            active_border   = colours.active_border,
            inactive_border = colours.inactive_border,
        },
    },

    decoration = {
        rounding         = 4,
        active_opacity   = 1.0,
        inactive_opacity = 1.0,
        blur = {
            enabled           = false,
            size              = 8,
            passes            = 2,
            new_optimizations = true,
        },
        shadow = {
            enabled = false,
        },
    },

    input = {
        kb_layout    = "{{KB_LAYOUT}}",
        kb_options   = "{{KB_OPTIONS}}",
        kb_variant   = "",
        kb_model     = "",
        kb_rules     = "",
        accel_profile = "flat",
        sensitivity  = {{MOUSE_SENSITIVITY}},
    },

    cursor = {
        no_warps = true,
    },

    misc = {
        focus_on_activate        = true,
        font_family              = "JetBrains Mono",
        disable_hyprland_logo    = true,
        disable_splash_rendering = true,
        force_default_wallpaper  = 0,
        vrr                      = 0,
    },

    debug = {
