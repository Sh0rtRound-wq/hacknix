#  ◈ SETTINGS (AUTOGENERATED FROM SETTINGS.JSON)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

general {
    border_size = 4
    gaps_in = 1
    gaps_out = 4
    resize_on_border = true
    extend_border_grab_area = 30
    col.active_border = $active_border
    col.inactive_border = $inactive_border
}

decoration {
    rounding = 4
    active_opacity = 1.0
    inactive_opacity = 1.0
    blur {
        enabled = false
        size = 8
        passes = 2
        new_optimizations = true
    }
    shadow {
        enabled = false
    }
}

input {
    kb_layout = {{KB_LAYOUT}}
    kb_options = {{KB_OPTIONS}}
    kb_variant =
    kb_model =
    kb_rules =
    accel_profile = flat
    sensitivity = {{MOUSE_SENSITIVITY}}
}

# Touchpad sensitivity overrides — covers both wlroots device variants:
# -mouse  (relative pointer device — cursor movement on some setups)
# -touchpad (main touchpad device — cursor movement on other setups)
# Whichever controls the cursor on this machine will pick up the override.
# The non-matching block is silently ignored by Hyprland.
device {
    name = {{TOUCHPAD_MOUSE_DEV}}
    sensitivity = {{TOUCHPAD_SENSITIVITY}}
    accel_profile = flat
    natural_scroll = false
}

device {
    name = {{TOUCHPAD_DEV}}
    sensitivity = {{TOUCHPAD_SENSITIVITY}}
    accel_profile = flat
    natural_scroll = false
}

cursor {
    no_warps = true
}

misc {
    focus_on_activate = true
    font_family = JetBrains Mono
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
    vfr = true
    vrr = 0
}

render {
    direct_scanout = false
}

ecosystem {
    no_update_news = true
    no_donation_nag = true
}

animations {
    enabled = yes
    bezier = myBezier, 0.05, 0.9, 0.1, 1.05
    animation = windows, 1, 5, myBezier, popin 80%
    animation = windowsOut, 1, 5, myBezier, popin 80%
    animation = layers, 1, 5, myBezier, fade
    animation = layersIn, 1, 5, myBezier, fade
    animation = layersOut, 1, 5, myBezier, fade
    animation = fade, 1, 5, myBezier
    animation = workspaces, 1, 5, myBezier, slide
    animation = specialWorkspaceIn, 1, 5, myBezier, fade
    animation = specialWorkspaceOut, 1, 5, myBezier, fade
}
