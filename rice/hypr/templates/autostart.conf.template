exec-once = $HOME/.local/bin/init-wallpaper
exec-once = hypridle
exec-once = playerctld
exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store
exec-once = systemctl --user enable --now easyeffects
exec-once = ~/.config/hypr/scripts/settings_watcher.sh &
exec-once = ~/.config/hypr/scripts/volume_listener.sh
exec-once = gsettings set org.gnome.desktop.interface cursor-theme 'ArcMidnight-Cursors'
exec-once = gsettings set org.gnome.desktop.interface cursor-size 36
exec-once = bash -c 'python3 ~/.config/hypr/scripts/quickshell-$(cat ~/.config/hypr/.qs_theme 2>/dev/null || echo modern)/focustime/focus_daemon.py'
