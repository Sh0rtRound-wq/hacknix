// ============================================================================
// config.kdl — Generated by settings_watcher.sh — DO NOT EDIT MANUALLY
// Source: ~/.config/niri/templates/config.kdl.template + settings.json
// ============================================================================

// ─── Input ───────────────────────────────────────────────────────────────────
input {
    keyboard {
        xkb {
            layout "{{KB_LAYOUT}}"
            options "{{KB_OPTIONS}}"
        }
        repeat-delay 600
        repeat-rate 25
    }

    mouse {
        accel-speed {{MOUSE_SENSITIVITY}}
        accel-profile "flat"
    }

    touchpad {
        accel-speed {{TOUCHPAD_SENSITIVITY}}
        accel-profile "flat"
        tap
        dwt  // disable while typing
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// ─── Monitor Outputs ─────────────────────────────────────────────────────────
{{OUTPUT_BLOCKS}}

// ─── Layout ──────────────────────────────────────────────────────────────────
layout {
    gaps 8

    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 1.0; }

    focus-ring {
        width 4
        active-color "{{ACTIVE_COLOR}}"
        inactive-color "{{INACTIVE_COLOR}}"
    }

    border {
        off
    }

    shadow {
        off
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

// ─── Cursor ──────────────────────────────────────────────────────────────────
cursor {
    hide-when-typing
}

// ─── Animations ──────────────────────────────────────────────────────────────
animations {
    slowdown 0.8
}

// ─── Environment Variables ───────────────────────────────────────────────────
environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XCURSOR_SIZE "36"
    XCURSOR_THEME "ArcMidnight-Cursors"
{{ENVIRONMENT_BLOCK}}
}

// ─── Autostart ───────────────────────────────────────────────────────────────
spawn-at-startup "bash" "-c" "exec $HOME/.local/bin/init-wallpaper"
spawn-at-startup "hypridle"
spawn-at-startup "playerctld"
spawn-at-startup "bash" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "bash" "-c" "wl-paste --type image --watch cliphist store"
spawn-at-startup "systemctl" "--user" "enable" "--now" "easyeffects"
spawn-at-startup "bash" "-c" "exec $HOME/.config/hypr/scripts/settings_watcher.sh"
spawn-at-startup "bash" "-c" "exec $HOME/.config/hypr/scripts/volume_listener.sh"
spawn-at-startup "bash" "-c" "gsettings set org.gnome.desktop.interface cursor-theme 'ArcMidnight-Cursors'"
spawn-at-startup "bash" "-c" "gsettings set org.gnome.desktop.interface cursor-size 36"
spawn-at-startup "bash" "-c" "python3 $HOME/.config/hypr/scripts/quickshell-$(cat $HOME/.config/hypr/.qs_theme 2>/dev/null || echo modern)/focustime/focus_daemon.py"
{{SPAWN_AT_STARTUP}}

// ─── Keybindings ─────────────────────────────────────────────────────────────
binds {
    // ── Window Management ──────────────────────────────────────────────────
    Mod+Q { close-window; }
    Alt+F4 { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+Tab { toggle-overview; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Down  { move-window-down-or-to-workspace-down; }

    Mod+Shift+Left  { set-column-width "-50"; }
    Mod+Shift+Right { set-column-width "+50"; }
    Mod+Shift+Up    { set-window-height "-50"; }
    Mod+Shift+Down  { set-window-height "+50"; }

    // ── Workspaces ─────────────────────────────────────────────────────────
    Mod+1 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 1"; }
    Mod+2 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 2"; }
    Mod+3 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 3"; }
    Mod+4 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 4"; }
    Mod+5 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 5"; }
    Mod+6 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 6"; }
    Mod+7 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 7"; }
    Mod+8 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 8"; }
    Mod+9 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 9"; }
    Mod+0 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 10"; }

    Mod+Shift+1 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 1 move"; }
    Mod+Shift+2 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 2 move"; }
    Mod+Shift+3 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 3 move"; }
    Mod+Shift+4 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 4 move"; }
    Mod+Shift+5 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 5 move"; }
    Mod+Shift+6 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 6 move"; }
    Mod+Shift+7 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 7 move"; }
    Mod+Shift+8 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 8 move"; }
    Mod+Shift+9 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 9 move"; }
    Mod+Shift+0 { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh 10 move"; }

    // ── System ─────────────────────────────────────────────────────────────
    Mod+L allow-when-locked=true { spawn "bash" "-c" "bash ~/.config/hypr/scripts/lock.sh"; }
    XF86PowerOff allow-when-locked=true { spawn "bash" "-c" "bash ~/.config/hypr/scripts/lock.sh"; }
    Caps_Lock allow-when-locked=true { spawn "bash" "-c" "sleep 0.1 && swayosd-client --caps-lock"; }

    // ── Screenshots ────────────────────────────────────────────────────────
    Print { spawn "bash" "-c" "~/.config/hypr/scripts/screenshot.sh"; }
    Shift+Print { spawn "bash" "-c" "~/.config/hypr/scripts/screenshot.sh --edit"; }
    Mod+Print { spawn "bash" "-c" "~/.config/hypr/scripts/screenshot.sh --full"; }
    Mod+Shift+Print { spawn "bash" "-c" "~/.config/hypr/scripts/screenshot.sh --full --edit"; }
    Mod+Shift+S { spawn "hyprshot" "-m" "region" "--clipboard-only"; }

    // ── Brightness ─────────────────────────────────────────────────────────
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }

    // ── Media ──────────────────────────────────────────────────────────────
    Mod+Space { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioMicMute allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    XF86AudioMute    allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }

    // ── Applications ───────────────────────────────────────────────────────
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "thunar"; }
    Mod+T { spawn "Telegram"; }
    Mod+O { spawn "obsidian"; }
    Mod+J { spawn "librewolf"; }

    // ── Quickshell Controls ────────────────────────────────────────────────
    Mod+M       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle monitors"; }
    Mod+R       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/reload.sh"; }
    Mod+D       { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh toggle applauncher"; }
    Mod+C       { spawn "bash" "-c" "~/.config/hypr/scripts/qs_manager.sh toggle clipboard"; }
    Mod+A       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle music"; }
    Mod+B       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle battery"; }
    Mod+W       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle wallpaper"; }
    Mod+S       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle calendar"; }
    Mod+N       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle network"; }
    Mod+Shift+T { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle focustime"; }
    Mod+V       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle volume"; }
    Mod+H       { spawn "bash" "-c" "bash ~/.config/hypr/scripts/qs_manager.sh toggle guide"; }

    // ── Dynamic Keybinds (from settings.json .keybinds[]) ─────────────────
{{DYNAMIC_KEYBINDS}}
}

// ─── Hotkey Overlay ──────────────────────────────────────────────────────────
hotkey-overlay {
    skip-at-startup
}

// Prefer no client-side decorations globally (removes X close buttons from title bars)
prefer-no-csd

// ─── Window Rules ────────────────────────────────────────────────────────────
window-rule {
    match title="float_kitty"
    open-floating true
    default-column-width { fixed 950; }
}

